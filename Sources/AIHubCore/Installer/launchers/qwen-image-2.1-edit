#!/bin/sh
set -eu

ROOT="${AIHUB_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo 'Usage: qwen-image-2.1-edit reference-image "edit instruction" [output.png]' >&2
  exit 2
fi

CLI="$ROOT/Source/stable-diffusion.cpp/build/bin/sd-cli"
MODELS="$ROOT/Models/Qwen-Image-2.1"
REFERENCE=$1
PROMPT=$2
OUTPUT=${3:-"$ROOT/Output/Qwen-Image-2.1/$(date +%Y%m%d-%H%M%S)-edit.png"}
if [ ! -f "$REFERENCE" ]; then echo "Reference image not found: $REFERENCE" >&2; exit 1; fi
if [ ! -x "$CLI" ]; then echo "Image runtime is missing: $CLI" >&2; exit 1; fi
mkdir -p "$(dirname "$OUTPUT")"
exec "$CLI" \
  --diffusion-model "$MODELS/diffusion/qwen_image_2.1-Q6_K.gguf" \
  --vae "$MODELS/vae/qwen_image_2.1_vae_bf16.safetensors" \
  --llm "$MODELS/text_encoder/Qwen3VL-8B-Instruct-Q4_K_M.gguf" \
  --llm_vision "$MODELS/text_encoder/mmproj-Qwen3VL-8B-Instruct-F16.gguf" \
  --steps "${QWEN_STEPS:-20}" --cfg-scale 6.0 --sampling-method euler \
  --seed "${QWEN_SEED:-42}" --offload-to-cpu -v -r "$REFERENCE" -p "$PROMPT" -o "$OUTPUT"
