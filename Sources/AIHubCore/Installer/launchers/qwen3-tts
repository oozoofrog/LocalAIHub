#!/bin/zsh
set -euo pipefail
ROOT="${AIHUB_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
export HF_HOME="$ROOT/Cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_XET_CACHE="$HF_HOME/xet"
export HF_ASSETS_CACHE="$HF_HOME/assets"
export XDG_CACHE_HOME="$ROOT/Cache/xdg"
MODEL="${QWEN3_TTS_MODEL:-$ROOT/Models/MLX-Audio/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit}"
exec "$ROOT/Environments/mlx-audio-py312/bin/mlx_audio.tts.generate" --model "$MODEL" "$@"
